# Copy to .env and fill in at least one channel. With no token set,
# only --dry-run runs work.

# Telegram (primary channel): bot token from @BotFather. A customer
# only has a chat id once they have opened the bot and pressed Start.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API: access token and the sender phone-number id
# from the Meta app dashboard.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Prepended to phone numbers that arrive without a country code (a
# leading trunk 0 is dropped first). E.g. 98 for Iran.
DEFAULT_COUNTRY_CODE=

# Pacing between sends and attempts per message.
SEND_INTERVAL_SECONDS=1.0
MAX_ATTEMPTS=3

# Delivery log location.
LOG_DB=deliveries.db
